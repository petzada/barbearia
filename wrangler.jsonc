{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker da Barbearia do Moura (Next.js via OpenNext).
  // worker.ts envolve o worker gerado pelo OpenNext e adiciona o Cron Trigger.
  "name": "barbearia-do-moura",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "barbearia-do-moura"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barbearia-do-moura",
      // Banco criado na conta Cloudflare (região ENAM).
      "database_id": "38d418bb-2ff0-4b51-a493-f1af62094f2f",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      // Fotos de perfil dos barbeiros e imagens enviadas pelo admin.
      "binding": "MEDIA",
      "bucket_name": "barbearia-do-moura-media"
    }
  ],
  "triggers": {
    // De hora em hora: a rota só envia na hora configurada no painel (padrão 08h SP).
    "crons": ["0 * * * *"]
  },
  "vars": {
    "APP_TIMEZONE": "America/Sao_Paulo"
  },
  "observability": {
    "enabled": true
  }
}
