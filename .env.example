# Copie para .env.local (não versionado). Nunca coloque valores reais aqui.
# No staging, as mesmas chaves vão no painel do Railway (H02). Segredo fica só no painel ou no .env.local.
# O processo ainda não lê as integrações abaixo: entram em T04, T08–T12 e T30.
# Os nomes são os que essas tasks vão consumir. Só acrescentar; não renomear.

# --- Aplicação ---

# Postgres de desenvolvimento: banco barbearia_dev no serviço Postgres do Railway (D0082).
# Preenchida por "pnpm db:bootstrap" a partir do Railway CLI. O nome do banco deve terminar em _dev.
DATABASE_URL=

# Postgres dos testes de integração: banco barbearia_test (pode ser zerado). O nome deve terminar em _test.
DATABASE_URL_TEST=

# URL pública da aplicação (links, redirects permitidos, base do Better Auth).
# Local: http://localhost:3000. Staging: o HTTPS do serviço web.
APP_URL=http://localhost:3000

# Identificador da barbearia deste deploy (um deploy por barbearia).
BARBEARIA_SLUG=

# development | test | production
NODE_ENV=development

# web no serviço web; worker no serviço worker (T12). Localmente os scripts definem.
# PROCESS_ROLE=web

# Opcional: nível do logger (pino). Padrão: info.
# LOG_LEVEL=info

# --- Login (T04, Better Auth + Google) ---

# Segredo de sessão. Gere na máquina: openssl rand -base64 32
# Não vem de painel de terceiro.
BETTER_AUTH_SECRET=

# Google Cloud → APIs e serviços → Tela de consentimento + Credenciais → ID do cliente OAuth (aplicativo da Web).
# Redirects a cadastrar (caminho padrão do Better Auth, exposto em T04):
#   {APP_URL}/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mercado Pago, cartão recorrente (T10) — credenciais de TESTE ---
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Sua integração → aplicação → Credenciais de teste (Public Key e Access Token).
# Produção (conta do dono da barbearia) só no H05. Não misture os dois conjuntos.
# O Access Token de teste começa com TEST-. A Public Key vai ao navegador (campo de cartão); o restante fica no servidor.

# Public Key de teste.
MERCADO_PAGO_PUBLIC_KEY=

# Access Token de teste. Só no servidor.
MERCADO_PAGO_ACCESS_TOKEN=

# Segredo da assinatura do webhook (header x-signature).
# Painel da aplicação → Webhooks → Configurar notificações → revelar a chave secreta.
# URL (só quando a rota existir em HTTPS; localhost não recebe):
#   {APP_URL}/api/webhooks/mercado-pago
# Tópicos: payment, subscription_preapproval, subscription_authorized_payment
# e, se o painel oferecer, topic_chargebacks_wh e topic_claims_integration_wh.
MERCADO_PAGO_WEBHOOK_SECRET=

# ID do vendedor de teste (user_id). Painel → Contas de teste → usuário vendedor.
# O adapter recusa webhook de outra conta (T10).
MERCADO_PAGO_USER_ID=

# --- Woovi, Pix Automático (T11) — sandbox ---
# Conta CNPJ do dono do produto. Sandbox: https://app.woovi-sandbox.com/
# AppID: plataforma → API / Plugins → criar aplicação. Header Authorization da API.
# AppID e URL têm de ser do mesmo ambiente (sandbox com sandbox, produção com produção).

# Sandbox: https://api.woovi-sandbox.com
# Produção (H05): https://api.woovi.com
WOOVI_API_BASE_URL=https://api.woovi-sandbox.com

WOOVI_APP_ID=

# Chave Pix da subconta da barbearia (é o id na API). Painel da subconta de teste, ou o pixKey da criação.
WOOVI_SUBACCOUNT_ID=

# Segredo HMAC do webhook (hmacSecretKey), header x-openpix-signature.
# Aparece ao salvar o webhook. A validação RSA (x-webhook-signature) usa a chave pública da Woovi e não precisa de variável.
# URL (só em HTTPS, quando a rota existir): {APP_URL}/api/webhooks/woovi
WOOVI_WEBHOOK_SECRET=

# --- WhatsMiau (T09) — plano Starter, um número de teste no piloto (D0031) ---
# Dashboard: https://whatsmiau.dev — API key da conta (header apikey) e instanceName escolhido ao criar a instância.
# No piloto, OTP e avisos apontam para a MESMA instância e a MESMA chave. Depois, cada canal pode ter o seu número.
# Base da API (fixa no código): https://api.whatsmiau.dev/v2

WHATSAPP_OTP_API_KEY=
WHATSAPP_OTP_INSTANCE=

WHATSAPP_AVISOS_API_KEY=
WHATSAPP_AVISOS_INSTANCE=

# Token que o nosso webhook exige. Gere: openssl rand -hex 32
# No webhook da instância, envie esse valor no header Authorization.
# URL (HTTPS público; a WhatsMiau recusa localhost): {APP_URL}/api/webhooks/whatsmiau
# Eventos: messages.upsert (mensagem recebida, inclusive SAIR) e connection.update (instância caiu).
WHATSAPP_WEBHOOK_TOKEN=

# --- Cloudflare R2 (T08) ---
# Painel Cloudflare → R2. Account ID na barra lateral.
# Manage R2 API tokens → token com leitura e escrita só no bucket. O secret aparece uma vez.
# Bucket privado (staging: barbearia-staging). CORS do bucket libera PUT a partir do domínio de APP_URL.
# O endpoint S3 é derivado: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Se a conta usar jurisdição (eu/fedramp), descomente R2_ENDPOINT com a URL que o painel mostrar.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# R2_ENDPOINT=

# --- Web Push da equipe (T30) ---
# Gere o par na máquina quando o script da T30 existir (ou: npx web-push generate-vapid-keys).
# Produção fica no Railway no H05. VAPID_SUBJECT é um mailto: ou a URL de APP_URL.

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@exemplo.com
